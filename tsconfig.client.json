{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["client/src/**/*.ts", "client/src/**/*.tsx", "shared/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
