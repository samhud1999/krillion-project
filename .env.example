# Separation Creek Krillion — server configuration
# Copy to .env and edit. Every setting is optional; the game runs with none of them.

# Port the single web + WebSocket server listens on.
PORT=8787

# Public URL players should open (printed on the host screen and inside the QR code).
# Leave blank to auto-detect from the request. Set it when behind a proxy or on a custom domain.
# PUBLIC_URL=https://krillion.example.com

# Postgres connection string. When set, rooms, players and every answer are persisted,
# and in-progress rooms survive a server restart. When blank, everything lives in memory
# for the night (perfectly fine for one weekend).
# DATABASE_URL=postgres://krillion:krillion@localhost:5432/krillion

# TLS for a hosted Postgres: normally the URL's sslmode is enough (Neon includes
# it; for Supabase append ?sslmode=require). Override with require | no-verify | disable,
# and point PGSSL_CA at a CA file if the provider hands you one.
# PGSSL=require
# PGSSL_CA=/path/to/ca.pem

# Extra origins allowed to open a WebSocket, comma separated. By default a browser's
# origin must match the server's own host or PUBLIC_URL, which is right for production.
# Only needed for the Vite dev server or unusual proxy setups.
# ALLOWED_ORIGINS=http://localhost:5173

# Optional secret the host must enter to create a room, so random visitors
# on a public URL cannot spin up games. Players never need it.
# HOST_PIN=1234

# Log level: debug | info | warn | error
LOG_LEVEL=info
