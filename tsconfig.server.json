{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist/server",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "noEmit": false
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules", "dist"]
}
