{
  "name": "separation-creek-krillion",
  "version": "1.0.0",
  "private": true,
  "description": "Separation Creek Krillion \u2014 a rare-answer trivia party game for one weekend down the Great Ocean Road. Host screen + up to 24 phones.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx server/db/migrate.ts",
    "simulate": "tsx scripts/simulate.ts",
    "bank:check": "tsx scripts/check-bank.ts",
    "bank:grade": "tsx scripts/grade-bank.ts",
    "bank:expand": "tsx scripts/expand-bank.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.7.11",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "motion": "^12.23.22",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
